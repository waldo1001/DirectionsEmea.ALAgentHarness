{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git filter-branch:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Edit(.alpackages/**)",
      "Write(.alpackages/**)",
      "mcp__al__al_getnextobjectid"
    ]
  },
  "extraKnownMarketplaces": {
    "bc-observatory": {
      "source": {
        "source": "github",
        "repo": "waldo1001/waldo.BCObservatory"
      }
    },
    "al-agent-harness": {
      "source": {
        "source": "github",
        "repo": "waldo1001/DirectionsEmea.ALAgentHarness"
      }
    }
  },
  "enabledPlugins": {
    "bc-observatory@bc-observatory": true,
    "al-agent-harness@al-agent-harness": true
  }
}
